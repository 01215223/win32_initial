# ========================================
# example.env - Development Paths Template
# ========================================
# Copy to .env and customize your paths
# ========================================

# SDL2 (x86\x64)
sdl2_lib_path_x86=C:\dev\SDL2\lib\x86
sdl2_lib_path_x64=C:\dev\SDL2\lib\x64
sdl2_include_path=C:\dev\SDL2\include

# SDL3 (x86\x64) 
sdl3_lib_path_x86=C:\dev\SDL3\lib\x86
sdl3_lib_path_x64=C:\dev\SDL3\lib\x64
sdl3_include_path=C:\dev\SDL3\include

# OpenCL (commented x86 = optional)
# opencl_lib_path_x86=C:\dev\opencl\icd-loader\x86
opencl_lib_path_x64=C:\dev\opencl\icd-loader\x64
opencl_include_path=C:\dev\opencl\headers

# LLVM\Clang
llvm_path=C:\LLVM\bin

# Vulkan SDK
vulkansdk_path=C:\VulkanSDK\1.3.XXX
vulkansdk_lib_path_x86=C:\VulkanSDK\1.3.XXX\Lib32
vulkansdk_lib_path_x64=C:\VulkanSDK\1.3.XXX\Lib
vulkansdk_include_path=C:\VulkanSDK\1.3.XXX\Include

# MSVC Build Tools
msvcl_build_path="C:\Program Files\Microsoft Visual Studio\2022\[Edition]\VC\Auxiliary\Build"

# MSVC Libs (uncomment as needed)
# msvcl_libs="kernel32.lib user32.lib gdi32.lib"

# TinyC Compiler
tcc_winapi_include_path=C:\TinyC\winapi\include
tcc_lib_path=C:\TinyC\tcc\lib
